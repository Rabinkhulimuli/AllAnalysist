{
  "name": "financial-analytics",
  "version": "0.1.0",
  "private": true,
  "description": "A financial analytics platform that enables users to upload and process financial documents and structured files such as PDFs, CSVs, and spreadsheets. The application automatically extracts and organizes financial data, including transactions, income, expenses, purchases, sales, gains, and losses, and transforms it into clear financial insights, profit and loss reports, monthly expense summaries, and comprehensive financial analytics.",
  "keywords": [
    "financial-analytics",
    "financial-management",
    "finance",
    "personal-finance",
    "financial-insights",
    "transaction-analysis",
    "profit-loss",
    "income-analysis",
    "expense-tracking",
    "expense-analysis",
    "buy-sell-analysis",
    "gains-losses",
    "financial-reports",
    "financial-dashboard",
    "document-processing",
    "financial-data-extraction",
    "ocr",
    "pdf-processing",
    "csv-processing",
    "spreadsheet-analysis",
    "data-analysis",
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "shadcn-ui",
    "tanstack-query",
    "axios"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Rabinkhulimuli/react-template.git"
  },
  "author": "Rabin Khulimuli",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint --fix",
    "lint:arch": "node scripts/check-architecture.js",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:staged": "node scripts/format-staged.mjs",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,md}\"",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "validate": "pnpm run lint:arch && pnpm run lint && pnpm run type-check"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,md}\"",
      "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,md}\""
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tabler/icons-react": "^3.46.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "husky": "^9.1.7",
    "lucide-react": "^1.28.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.25",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3"
  }
}
